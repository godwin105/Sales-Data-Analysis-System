# =========================================================================
# Backend (.env) — copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# =========================================================================

# ---- Flask ----
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# ---- MySQL (XAMPP defaults shown) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=sales_analysis_db

# ---- CORS — frontend URL(s) allowed to call the API ----
# Comma-separated. Default is the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend URL (used in password reset emails) ----
FRONTEND_URL=http://localhost:5173

# ---- Email / SMTP (leave MAIL_USERNAME blank for dry-run mode) ----
# Gmail example:
# MAIL_USERNAME=youremail@gmail.com
# MAIL_PASSWORD=your-16-char-app-password   (NOT your real Gmail password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Biashara App
MAIL_FROM_ADDRESS=
